# Copy to .env and fill before launch: docker compose -f docker-compose.prod.yml up -d --build

ENVIRONMENT=prod
DEBUG=false

# Required — generate a long random string (never use dev-secret-key)
SECRET_KEY=change-me-to-a-long-random-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mosafer

# Public URLs (no trailing slash on API_PUBLIC_URL / WEB_APP_URL)
API_PUBLIC_URL=https://api.yourdomain.com
WEB_APP_URL=https://yourdomain.com

# SMTP — Gmail (enable 2FA, then create an App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=false
SMTP_START_TLS=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=you@gmail.com

# Google Maps Platform (server key; restrict by server IP, enable Routes API + Geocoding API)
# Flutter client uses GOOGLE_MAPS_API_KEY in Android/iOS manifests separately.
GOOGLE_ROUTES_ENABLED=true
GOOGLE_MAPS_SERVER_API_KEY=AIza...
# Optional dev alias — copied to GOOGLE_MAPS_SERVER_API_KEY when the server key is unset:
# GOOGLE_MAPS_API_KEY=AIza...

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://yourdomain.com
TRUSTED_HOSTS=api.yourdomain.com,yourdomain.com

# Payments — mock (default) or stripe for real Checkout
# PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from: stripe listen --forward-to localhost:8001/api/v1/payments/stripe/webhook
# Stripe test card: 4242 4242 4242 4242 · any future expiry · any CVC

# Optional admin seed (Alembic migration) — used on first Docker migrate run
ADMIN_EMAIL=kasalalem@gmail.com
ADMIN_PASSWORD=change-me-in-production
